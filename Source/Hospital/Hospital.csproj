<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Hospital</RootNamespace>
        <AssemblyName>Hospital</AssemblyName>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <!-- Which RimWorld version to build for. Defaults to 1.6, so an ordinary build is
             unchanged; pass -p:RwVersion=1.5 to build the 1.5 assembly instead. The output
             folder follows, so each build lands in its own version folder. -->
        <RwVersion Condition="'$(RwVersion)'==''">1.6</RwVersion>
        <OutputPath>..\..\$(RwVersion)\Assemblies\</OutputPath>
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DefineConstants>TRACE;NDEBUG</DefineConstants> <!-- All published builds have to be built as 'release' because of the debug flag! -->
        <WarningLevel>4</WarningLevel>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- Unsafe is required for publicising! -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>TRACE;DEBUG</DefineConstants>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>../../$(RwVersion)/Assemblies</OutputPath>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <!-- Per-game-version package versions. This has to come after the Debug/Release groups,
         which assign DefineConstants outright and would otherwise drop RW15. -->
    <PropertyGroup Condition="'$(RwVersion)'=='1.6'">
        <RimWorldRefVersion>1.6.4633</RimWorldRefVersion>
        <MultiplayerApiVersion>0.6.0</MultiplayerApiVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RwVersion)'=='1.5'">
        <RimWorldRefVersion>1.5.4409</RimWorldRefVersion>
        <!-- MultiplayerAPI 0.6.0 requires a 1.6 reference assembly; 0.5.0 needs only 1.4.3641. -->
        <MultiplayerApiVersion>0.5.0</MultiplayerApiVersion>
        <DefineConstants>$(DefineConstants);RW15</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" />
        <!-- Use Version="*-*" to get the latest beta! -->
        <PackageReference Include="Lib.Harmony" Version="*" ExcludeAssets="runtime" />
        <PackageReference Include="RimWorld.MultiplayerAPI" Version="$(MultiplayerApiVersion)" />
    </ItemGroup>
    <ItemGroup>
        <Publicize Include="Assembly-CSharp" />
    </ItemGroup>
</Project>